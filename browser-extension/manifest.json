{
  "manifest_version": 3,
  "name": "Screensaver — Full Page Capture",
  "version": "0.1.0",
  "description": "Capture the full scrollable page as one stitched image. Save as PNG, JPG, or PDF.",
  "permissions": ["activeTab", "scripting", "downloads", "clipboardWrite"],
  "action": {
    "default_title": "Capture full page"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
